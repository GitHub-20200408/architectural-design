        <mxCell id="8FZrH637tasNtI_oPU0--12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;h3 style=&quot;font-family: Verdana; text-align: left;&quot;&gt;&lt;strong&gt;不要完全放弃向量检索&lt;/strong&gt;&lt;/h3&gt;&lt;p style=&quot;font-family: Verdana; text-align: left;&quot;&gt;SAG2 的 BM25 方案很有价值，但中文技术文档中经常出现：&lt;/p&gt;&lt;ul style=&quot;font-family: Verdana; text-align: left;&quot;&gt;&lt;li&gt;&lt;p&gt;HTP 和 Hexagon Tensor Processor。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;QNN 和 Qualcomm Neural Network。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;模型转换和模型编译。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;内存占用和 RSS。&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;推理加速和硬件 Offload。&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;font-family: Verdana; text-align: left;&quot;&gt;这些概念之间有语义关系，却不一定存在相同的词项。&lt;/p&gt;" vertex="1">
